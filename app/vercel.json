{
    "version": 2,
    "builds": [
        {
            "src": "app/web/**",
            "use": "@vercel/static"
        },
        {
            "src": "app/Admin/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/Admin/(.*)",
            "dest": "/app/Admin/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/app/web/$1"
        }
    ]
}